# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.egg-info
build/
dist/
wheels/
.ipynb_checkpoints/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Large data (NOT for GitHub — 30 GB ESA telemetry, regenerable plans) ───────
data/

# ── Trained models — keep only the canonical final/ set (~31 MB) ───────────────
# Intermediate phase*/step checkpoints (hundreds of MB) are excluded; the
# canonical models in checkpoints/final/ ARE tracked for reproducibility,
# including the two Phase-12 real-TLE fine-tunes (emrl_tle_ft*_k16.pt).
checkpoints/*
!checkpoints/final/

# ── Training logs / TensorBoard ────────────────────────────────────────────────
results/**/logs/
results/**/_logs*/
*tfevents*
*.log
*.out

# ── Build artifacts / bundles ──────────────────────────────────────────────────
*.zip

# ── Editor / OS / agent ────────────────────────────────────────────────────────
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Superseded / scratch (kept on disk, excluded from the repo) ────────────────
# Old auto-generated figures at repo root (regenerate via scripts/visualization/).
# Root-anchored so it does NOT match deliverables/figures/ (which IS tracked).
/figures/
# Superseded experiment scripts (provenance only).
archive/
# results/ IS tracked — keep the canonical .json/.csv, exclude run logs and
# scratch stdout/stderr dumps (*.log and *.out are already ignored globally).
results/*.txt
# Earlier scratch docs — current manuscript lives in deliverables/MANUSCRIPT.md.
/paper_draft.md
/context.md
/reviewer_response.md
colab_train.ipynb
deliverables/*.md
# Checkpoint backups
*.bak

# ── Documentation: ONLY the root README.md is tracked; all other .md is internal ─
# deliverables/*.md (manuscript, rebuttal, mentor notes, appendices) are internal —
# share them directly with co-authors, do NOT push them to the repo.
*.md
!/README.md
